# Source definition only. Build/deployment need separate operator approval.
FROM mcr.microsoft.com/playwright/python:v1.58.0-noble

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app
COPY finpay_pipeline/requirements.txt ./requirements-finpay.txt
COPY finpay_pipeline/requirements-digipos-scraper.txt ./requirements-browser.txt
RUN pip install --no-cache-dir -r requirements-finpay.txt -r requirements-browser.txt
COPY finpay_pipeline/*.py ./finpay_pipeline/
COPY finpay_pipeline/cell_format ./finpay_pipeline/cell_format
COPY finpay_pipeline/migrations ./finpay_pipeline/migrations
COPY finpay_pipeline/queries ./finpay_pipeline/queries

ENV PYTHONPATH=/app
CMD ["python", "-c", "from finpay_pipeline import acquire_cell_bundle, acquire_cell_bundle_v3; print('cell scraper APIs ready')"]
