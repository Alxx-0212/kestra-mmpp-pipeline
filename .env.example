# Copy this file to .env and replace placeholder values before running Docker Compose.
# 
# SECRET MANAGEMENT STRATEGY:
# - All passwords and secrets are managed via Docker Secrets (files in ./secrets/)
# - This file only contains NON-SENSITIVE configuration (usernames, database names, URLs)
# - Actual secret values are stored in ./secrets/*.txt files (chmod 600)
# - For production, replace secret files with values from your vault (HashiCorp Vault, AWS Secrets Manager, etc.)
#
# DO NOT COMMIT ACTUAL SECRET VALUES TO VERSION CONTROL

# Kestra metadata database
KESTRA_POSTGRES_DB=kestra
KESTRA_POSTGRES_USER=kestra
# KESTRA_POSTGRES_PASSWORD -> stored in ./secrets/kestra_postgres_password.txt (Docker Secret)
KESTRA_BASIC_AUTH_USERNAME=admin@example.com
# Local Compose mode aliases the local Postgres hostname and alert-chat secret.
# Set false only after switching to the production secret/tunnel configuration.
KESTRA_LOCAL_MODE=true
# The current standalone Kestra v1.3 reads its global Basic-auth password from
# this environment file (KESTRA_BASIC_AUTH_PASSWORD) via Compose interpolation.
# The mounted kestra_basic_auth_password.txt secret is not the authoritative
# value; the Telegram bot receives the same environment setting.
# KESTRA_BASIC_AUTH_PASSWORD=<real-password>

# FinPay application database (Top Up + reconciliation)
FINPAY_DB_NAME=finpay
FINPAY_DB_USER=finpay
# FINPAY_DB_PASSWORD -> stored in ./secrets/finpay_db_password.txt (Docker Secret)

# FinPay Transaction database (new, separate from top-up)
FINPAY_TXN_DB_NAME=finpay_txn
FINPAY_TXN_DB_USER=finpay_txn
# FINPAY_TXN_DB_PASSWORD -> stored in ./secrets/finpay_txn_db_password.txt (Docker Secret)

# Optional dashboard profile: Superset/Superset MCP are disabled by default.
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
# SUPERSET_DB_PASSWORD -> stored in ./secrets/superset_db_password.txt (Docker Secret)

# LinkAja application database
LINKAJA_DB_NAME=linkaja
LINKAJA_DB_USER=linkaja
# LINKAJA_DB_PASSWORD -> stored in ./secrets/linkaja_db_password.txt (Docker Secret)

# Optional historical Grist prototype; enable only with --profile optional-dashboard.
GRIST_DB_NAME=grist
GRIST_DB_USER=grist
# GRIST_DB_PASSWORD=              # keep only in ignored .env/secrets
# GRIST_BOOT_KEY=                 # keep only in ignored .env/secrets

# FinPay read-only user for Grist external connection
# FINPAY_READONLY_PASSWORD -> stored in ./secrets/finpay_readonly_password.txt (Docker Secret)

# pgAdmin removed - use DataGrip (or psql) instead

# Superset dashboard
# SUPERSET_SECRET_KEY -> stored in ./secrets/superset_secret_key.txt (Docker Secret)
SUPERSET_ADMIN_USERNAME=admin
# SUPERSET_ADMIN_PASSWORD -> stored in ./secrets/superset_admin_password.txt (Docker Secret)
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=Finance
SUPERSET_ADMIN_LASTNAME=Admin
SUPERSET_DASHBOARD_URL=http://localhost:8088/superset/dashboard/finpay-topup/
SUPERSET_DEV_AUTO_LOGIN=true
SUPERSET_MCP_AUTH_ENABLED=false
SUPERSET_MCP_DEV_USERNAME=admin

# FinPay Top Up uses the Telegram/Kestra webhook path. No legacy refresh service.
KESTRA_PUBLIC_URL=http://localhost:8081
FINPAY_TOPUP_KESTRA_NAMESPACE=finance.finpay
FINPAY_TOPUP_KESTRA_FLOW_ID=finpay_topup_pipeline_v1

# FinPay Telegram Kredit classification bot.
# Local behavior-test defaults to this private Telegram user/chat. Replace both
# values before production deployment; the bot fails closed when either is empty.
TELEGRAM_ALLOWED_CHAT_IDS=2142781580
TELEGRAM_ALLOWED_USER_IDS=2142781580
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_BOT_PUBLIC_BASE_URL=
# Local live E2E ngrok token. Keep the real value only in ignored .env.
NGROK_AUTHTOKEN=
# The local Compose file builds mmpp-telegram-bot:local. Production later
# changes the Compose image/pull policy to an immutable GHCR image.
TELEGRAM_BOT_IMAGE=mmpp-telegram-bot:local
TELEGRAM_BOT_PULL_POLICY=never
# In-memory Telegram /refresh cooldown per chat.
TELEGRAM_REFRESH_COOLDOWN_SECONDS=600
# Enable both automatic refresh routes after validation.
TELEGRAM_SELECTIVE_REFRESH_ENABLED=true
# TELEGRAM_BOT_TOKEN -> stored in ./secrets/telegram_bot_token.txt (Docker Secret)
# TELEGRAM_WEBHOOK_SECRET -> stored in ./secrets/telegram_webhook_secret.txt (Docker Secret)
# Production named-tunnel token -> stored in ./secrets/cloudflare_tunnel_token.txt
# Kestra flow alerts use the same finpay_topup_bot token from
# secrets/telegram_bot_token.txt and SECRET_TELEGRAM_ALERT_CHAT_ID from .env_encoded.

# Kestra workflow secrets belong in .env_encoded, not in this file.
# SECRET_FINPAY_TOPUP_OPERATOR_ALLOWLIST -> comma-separated operator names in .env_encoded.
