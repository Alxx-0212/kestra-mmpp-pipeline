# Copy this file to .env_encoded and replace each value with a base64-encoded
# value before running Kestra locally.
#
# Example:
#   printf '%s' 'real-secret-value' | base64 -w0

# Google service account JSON for {{ secret('GCP_SA_KEY') }}
SECRET_GCP_SA_KEY=e30=

# Telegram alerting secrets
SECRET_TELEGRAM_BOT_TOKEN=Y2hhbmdlLW1l
SECRET_TELEGRAM_CHAT_ID=Y2hhbmdlLW1l

# FinPay workflow database settings
SECRET_FINPAY_DB_HOST=ZmlucGF5LXBvc3RncmVz
SECRET_FINPAY_DB_PORT=NTQzMg==
SECRET_FINPAY_DB_NAME=ZmlucGF5
SECRET_FINPAY_DB_USER=ZmlucGF5
SECRET_FINPAY_DB_PASSWORD=Y2hhbmdlLW1l

# FinPay Top Up pipeline webhook trigger key (use a strong random value, e.g.:
#   printf '%s' "$(openssl rand -hex 16)" | base64 -w0)
SECRET_FINPAY_TOPUP_WEBHOOK_KEY=Y2hhbmdlLW1l

# DigiPOS Monitoring Top Up password for the trigger-based extractor
SECRET_DIGIPOS_PASSWORD=Y2hhbmdlLW1l

# Google Sheets access/protection settings
# Use X19FTVBUWV9f, base64 for __EMPTY__, for intentionally blank optional lists.
SECRET_FINPAY_SPREADSHEET_WRITER_EMAILS=b3duZXJAZXhhbXBsZS5jb20=
SECRET_FINPAY_SPREADSHEET_LOCALE=ZW5fR0I=
SECRET_FINPAY_SPREADSHEET_TIMEZONE=QXNpYS9NYWthc3Nhcg==
SECRET_FINPAY_PROTECTION_EDITOR_EMAILS=b3duZXJAZXhhbXBsZS5jb20sc2VydmljZS1hY2NvdW50QGV4YW1wbGUuaWFtLmdzZXJ2aWNlYWNjb3VudC5jb20=
SECRET_FINPAY_MANDIRI_EDITOR_EMAILS=X19FTVBUWV9f

# FinPay Transaction database (new, separate from finpay top-up)
SECRET_FINPAY_TXN_DB_HOST=cG9zdGdyZXM=
SECRET_FINPAY_TXN_DB_PORT=NTQzMg==
SECRET_FINPAY_TXN_DB_NAME=ZmlucGF5X3R4bg==
SECRET_FINPAY_TXN_DB_USER=ZmlucGF5X3R4bg==
SECRET_FINPAY_TXN_DB_PASSWORD=Y2hhbmdlLW1l

# Superset metadata database (Stage 1)
SECRET_SUPERSET_DB_HOST=cG9zdGdyZXM=
SECRET_SUPERSET_DB_PORT=NTQzMg==
SECRET_SUPERSET_DB_NAME=c3VwZXJzZXQ=
