{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": "{{DEFAULT_MINIMUM_TOKENS}}"
      },
      "enabled": true
    },
    "kestra": {
      "type": "remote",
      "url": "https://api.kestra.io/v1/mcp",
      "enabled": true,
      "timeout": 15000
    }
  }
}
