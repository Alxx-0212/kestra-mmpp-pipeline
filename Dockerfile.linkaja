FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-linkaja.txt .
RUN pip install --no-cache-dir -r requirements-linkaja.txt

COPY linkaja_fee_pipeline ./linkaja_fee_pipeline
COPY linkaja_pipeline.py ./linkaja_pipeline.py

CMD ["python", "-c", "print('linkaja-fee-pipeline image ready')"]
