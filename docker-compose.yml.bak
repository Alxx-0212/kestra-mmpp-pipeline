# MMPP finance local stack
# Shared network: mmpp-finance-network
# Single PostgreSQL instance hosting: kestra, finpay, finpay_txn, linkaja

services:
  # Single PostgreSQL instance hosting all project databases
  # - kestra:      Kestra metadata (workflows, executions, queue)
  # - finpay:      FinPay Top Up + reconciliation data (existing contract DB)
  # - finpay_txn:  FinPay Transaction processing data (new, separate from top-up)
  # - linkaja:     LinkAja fee pipeline data (future)
  postgres:
    image: postgres:18.4
    networks:
      - mmpp-finance-network
    volumes:
      - postgres-data:/var/lib/postgresql
      - ./docker/initdb:/docker-entrypoint-initdb.d:ro
    environment:
      POSTGRES_DB: ${KESTRA_POSTGRES_DB}
      POSTGRES_USER: ${KESTRA_POSTGRES_USER}
      POSTGRES_PASSWORD: ${KESTRA_POSTGRES_PASSWORD}
      # Project database credentials consumed by init script
      FINPAY_DB_NAME: ${FINPAY_DB_NAME}
      FINPAY_DB_USER: ${FINPAY_DB_USER}
      FINPAY_DB_PASSWORD: ${FINPAY_DB_PASSWORD}
      FINPAY_TXN_DB_NAME: ${FINPAY_TXN_DB_NAME}
      FINPAY_TXN_DB_USER: ${FINPAY_TXN_DB_USER}
      FINPAY_TXN_DB_PASSWORD: ${FINPAY_TXN_DB_PASSWORD}
      LINKAJA_DB_NAME: ${LINKAJA_DB_NAME}
      LINKAJA_DB_USER: ${LINKAJA_DB_USER}
      LINKAJA_DB_PASSWORD: ${LINKAJA_DB_PASSWORD}
    ports:
      - "5433:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d $${POSTGRES_DB} -U $${POSTGRES_USER}"]
      interval: 30s
      timeout: 10s
      retries: 10

  kestra:
    image: kestra/kestra:v1.3.26
    networks:
      - mmpp-finance-network
    stop_grace_period: 6m
    user: "root"
    command: server standalone
    volumes:
      - kestra-data:/app/storage
      - /var/run/docker.sock:/var/run/docker.sock
      - /tmp/kestra-wd:/tmp/kestra-wd
    env_file:
      - .env_encoded
    environment:
      KESTRA_CONFIGURATION: |
        datasources:
          postgres:
            url: jdbc:postgresql://postgres:5432/${KESTRA_POSTGRES_DB}
            driverClassName: org.postgresql.Driver
            username: ${KESTRA_POSTGRES_USER}
            password: ${KESTRA_POSTGRES_PASSWORD}
        kestra:
          secrets:
            type: env
          server:
            basic-auth:
              username: ${KESTRA_BASIC_AUTH_USERNAME}
              password: ${KESTRA_BASIC_AUTH_PASSWORD}
          repository:
            type: postgres
          storage:
            type: local
            local:
              base-path: "/app/storage"
          queue:
            type: postgres
          tasks:
            tmp-dir:
              path: /tmp/kestra-wd/tmp
            python:
              version: "3.11"
          url: http://localhost:8081/
          
          plugins:
            configurations:
              - type: io.kestra.plugin.scripts.runner.docker.Docker
                values:
                  volumeEnabled: true
                  networkMode: mmpp-finance-network
    ports:
      - "8081:8080"
    depends_on:
      postgres:
        condition: service_healthy

  superset:
    build:
      context: .
      dockerfile: Dockerfile.superset
    image: mmpp-superset:6.1.0-postgres-mcp
    networks:
      - mmpp-finance-network
    volumes:
      - superset-home:/app/superset_home
      - ./config/superset_config.py:/app/pythonpath/superset_config.py:ro
    environment:
      SUPERSET_CONFIG_PATH: /app/pythonpath/superset_config.py
      SUPERSET_SECRET_KEY: ${SUPERSET_SECRET_KEY:-change-me-use-a-long-random-secret}
      SUPERSET_ADMIN_USERNAME: ${SUPERSET_ADMIN_USERNAME:-admin}
      SUPERSET_ADMIN_PASSWORD: ${SUPERSET_ADMIN_PASSWORD:-change-me}
      SUPERSET_ADMIN_EMAIL: ${SUPERSET_ADMIN_EMAIL:-admin@example.com}
      SUPERSET_ADMIN_FIRSTNAME: ${SUPERSET_ADMIN_FIRSTNAME:-Finance}
      SUPERSET_ADMIN_LASTNAME: ${SUPERSET_ADMIN_LASTNAME:-Admin}
      SUPERSET_LOAD_EXAMPLES: "no"
      SUPERSET_DEV_AUTO_LOGIN: ${SUPERSET_DEV_AUTO_LOGIN:-true}
      SUPERSET_MCP_AUTH_ENABLED: ${SUPERSET_MCP_AUTH_ENABLED:-false}
      SUPERSET_MCP_DEV_USERNAME: ${SUPERSET_MCP_DEV_USERNAME:-admin}
      SUPERSET_WEBDRIVER_BASEURL: http://superset:8088/
      # Explicitly configure MCP
      SUPERSET_MCP_HOST: 0.0.0.0
      SUPERSET_MCP_PORT: 5008
    command:
      - /bin/sh
      - -c
      - |
        /app/.venv/bin/superset db upgrade &&
        (/app/.venv/bin/superset fab create-admin \
          --username "$${SUPERSET_ADMIN_USERNAME}" \
          --firstname "$${SUPERSET_ADMIN_FIRSTNAME}" \
          --lastname "$${SUPERSET_ADMIN_LASTNAME}" \
          --email "$${SUPERSET_ADMIN_EMAIL}" \
          --password "$${SUPERSET_ADMIN_PASSWORD}" || true) &&
        /app/.venv/bin/superset init &&
        /app/.venv/bin/superset run -h 0.0.0.0 -p 8088 --with-threads
    ports:
      - "8088:8088"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "/app/.venv/bin/python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8088/health', timeout=5)\""]
      interval: 30s
      timeout: 10s
      retries: 10

  superset-mcp:
    image: mmpp-superset:6.1.0-postgres-mcp
    networks:
      - mmpp-finance-network
    volumes:
      - superset-home:/app/superset_home
      - ./config/superset_config.py:/app/pythonpath/superset_config.py:ro
    environment:
      SUPERSET_CONFIG_PATH: /app/pythonpath/superset_config.py
      SUPERSET_SECRET_KEY: ${SUPERSET_SECRET_KEY:-change-me-use-a-long-random-secret}
      SUPERSET_MCP_AUTH_ENABLED: ${SUPERSET_MCP_AUTH_ENABLED:-false}
      SUPERSET_MCP_DEV_USERNAME: ${SUPERSET_MCP_DEV_USERNAME:-admin}
      SUPERSET_WEBDRIVER_BASEURL: http://superset:8088/
      # Explicit MCP configuration
      SUPERSET_MCP_HOST: 0.0.0.0
      SUPERSET_MCP_PORT: 5008
    command: ["/app/.venv/bin/superset", "mcp", "run", "--host", "0.0.0.0", "--port", "5008"]
    ports:
      - "5008:5008"
    depends_on:
      superset:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "/app/.venv/bin/python -c \"import urllib.request,urllib.error; \ntry:\n    urllib.request.urlopen('http://127.0.0.1:5008/mcp', timeout=5)\nexcept urllib.error.HTTPError as e:\n    raise SystemExit(0 if e.code==405 else 1)\nraise SystemExit(1)\""]
      interval: 30s
      timeout: 10s
      retries: 10

  # FinPay Top Up Refresh Service
  # NOTE: Deprecated fallback trigger. The primary refresh path is now the
  # Kestra webhook/flow executed directly from the Superset dashboard. This
  # service is retained for local convenience and will be removed once the
  # dashboard-to-Kestra direct integration is validated in production.
  finpay-topup-refresh:
    build:
      context: .
      dockerfile: Dockerfile.topup
    networks:
      - mmpp-finance-network
    command: ["python", "-m", "finpay_topup_pipeline", "refresh-service"]
    environment:
      FINPAY_REFRESH_HOST: 0.0.0.0
      FINPAY_REFRESH_PORT: 8095
      FINPAY_REFRESH_BASIC_USER: ${FINPAY_REFRESH_BASIC_USER:-finance}
      FINPAY_REFRESH_BASIC_PASSWORD: ${FINPAY_REFRESH_BASIC_PASSWORD:-change-me}
      KESTRA_BASE_URL: http://kestra:8080
      KESTRA_PUBLIC_URL: ${KESTRA_PUBLIC_URL:-http://localhost:8081}
      KESTRA_BASIC_AUTH_USERNAME: ${KESTRA_BASIC_AUTH_USERNAME}
      KESTRA_BASIC_AUTH_PASSWORD: ${KESTRA_BASIC_AUTH_PASSWORD}
      KESTRA_NAMESPACE: ${FINPAY_TOPUP_KESTRA_NAMESPACE:-finance.finpay}
      KESTRA_FLOW_ID: ${FINPAY_TOPUP_KESTRA_FLOW_ID:-finpay_topup_pipeline_v1}
      SUPERSET_DASHBOARD_URL: ${SUPERSET_DASHBOARD_URL:-http://localhost:8088/superset/dashboard/finpay-topup/}
      # Pipeline DB coordinates (consumed by the top-up pipeline; resolves to the
      # existing `finpay` database via the Kestra FINPAY_DB_NAME secret)
      FINPAY_DB_HOST: postgres
      FINPAY_DB_PORT: 5432
      FINPAY_DB_NAME: ${FINPAY_DB_NAME}
      FINPAY_DB_USER: ${FINPAY_DB_USER}
      FINPAY_DB_PASSWORD: ${FINPAY_DB_PASSWORD}
    ports:
      - "8095:8095"
    depends_on:
      kestra:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8095/healthz', timeout=5)\""]
      interval: 30s
      timeout: 10s
      retries: 10

volumes:
  postgres-data:
    driver: local
  kestra-data:
    driver: local
  superset-home:
    driver: local

networks:
  mmpp-finance-network:
    name: mmpp-finance-network
    driver: bridge
